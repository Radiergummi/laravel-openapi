#!/usr/bin/env bash
# survey-generate <app> — openapi:generate -> generated-spec.json (PHP 8.4 on PATH).
set -uo pipefail
WS="${WS:?set WS}"; app="${1:?usage: survey-generate <app>}"
repo="$WS/apps/$app/repo"; out="$WS/apps/$app/generated-spec.json"; err="$WS/apps/$app/generate.log"
( cd "$repo" && php artisan openapi:generate --output=- --format=json ) > "$out" 2> "$err"
ex=$?
echo "gen_exit=$ex  spec=$out"
[[ -s "$err" ]] && { echo "  stderr:"; tail -3 "$err"; }
exit 0
