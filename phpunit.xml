<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".cache/phpunit">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>
        <testsuite name="PhpStan">
            <directory>tests/PhpStan</directory>
        </testsuite>
        <!-- Tests for the repo's own tooling (tools/survey, .claude/skills/survey), not the
             shipped library. Kept out of the library suites so a tooling regression does not
             red the library gate; run as a dedicated CI job. -->
        <testsuite name="Tools">
            <directory>tests/Tools</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <coverage>
        <report>
            <clover outputFile=".cache/clover.xml"/>
            <html outputDirectory=".cache/coverage"/>
        </report>
    </coverage>
    <php>
        <!-- DocsController routes default to the `web` middleware stack, which loads
             EncryptCookies / StartSession. Both require APP_KEY. Setting a fixed test
             key here keeps Testbench-driven HTTP request tests working without each
             test having to wire its own encryption key into defineEnvironment(). -->
        <env name="APP_KEY" value="base64:RmI4VHpsM3hVcjVxZUtBNlBZRGN3aFB4WGZJNVlOcEU="/>
    </php>
</phpunit>
