{
    "name": "radiergummi/laravel-openapi",
    "description": "Convention-driven OpenAPI 3.1 generation and documentation linting for Laravel.",
    "keywords": ["laravel", "openapi", "swagger", "api-documentation", "linter"],
    "license": "MIT",
    "authors": [
        { "name": "Moritz Friedrich", "email": "moritz.friedrich@gmail.com" }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "phpdocumentor/reflection-docblock": "^5.4",
        "spatie/laravel-data": "^4.0",
        "symfony/type-info": "^7.2",
        "zircote/swagger-php": "^4.10"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/framework": "^12.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0"
    },
    "suggest": {
        "laravel/passport": "Enables OAuth scope-coverage validation in `openapi:lint` (^13.0)."
    },
    "autoload": {
        "psr-4": { "Radiergummi\\OpenApi\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Radiergummi\\OpenApi\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Radiergummi\\OpenApi\\OpenApiServiceProvider"]
        }
    },
    "scripts": {
        "test": "pest --no-coverage",
        "lint": "pint",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "pestphp/pest-plugin": true }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
