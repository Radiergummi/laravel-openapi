{
    "name": "radiergummi/laravel-openapi",
    "description": "Convention-driven OpenAPI 3.1 generation and documentation linting for Laravel.",
    "keywords": [ "laravel", "laravel-package", "openapi", "swagger", "api-documentation", "linter" ],
    "license": "MIT",
    "authors": [
        {
            "name": "Moritz Mazetti",
            "email": "moritz@mazetti.me"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "opis/json-schema": "^2.6.0",
        "phpdocumentor/reflection-docblock": "^6.0.3",
        "spatie/laravel-data": "^4.23.0",
        "symfony/type-info": "^v8.0.9",
        "zircote/swagger-php": "^6.1.2"
    },
    "require-dev": {
        "larastan/larastan": "^v3.9.6",
        "laravel/passport": "^v13.7.5",
        "laravel/pint": "^v1.29.1",
        "league/fractal": "^0.20.2",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8.0 || ^4.7.0",
        "pestphp/pest-plugin-laravel": "^3.2.0 || ^4.1.0",
        "spatie/laravel-fractal": "^6.4",
        "spatie/laravel-query-builder": "^7.3"
    },
    "suggest": {
        "laravel/passport": "Enables OAuth scope-coverage validation in `openapi:lint` (^13.0).",
        "spatie/laravel-data": "Enables support for Spatie Laravel Data objects as schema components (^4.0).",
        "spatie/laravel-query-builder": "Enables documentation of #[AllowedFilter]/#[AllowedSort]/#[AllowedInclude] (^6.0)."
    },
    "autoload": {
        "psr-4": {
            "Radiergummi\\OpenApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Radiergummi\\OpenApi\\Tests\\": "tests/",
            "Examples\\Shared\\":        "examples/_shared/",
            "Examples\\Vanilla\\":       "examples/vanilla/",
            "Examples\\FormRequests\\":  "examples/form-requests/",
            "Examples\\SpatieData\\":    "examples/spatie-data/",
            "Examples\\QueryBuilder\\":  "examples/query-builder/",
            "Examples\\Combined\\":      "examples/combined/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [ "Radiergummi\\OpenApi\\OpenApiServiceProvider" ]
        }
    },
    "scripts": {
        "test": "pest --no-coverage",
        "lint": "pint",
        "analyse": "phpstan analyse",
        "examples:vanilla":       "@php examples/generate.php vanilla",
        "examples:form-requests": "@php examples/generate.php form-requests",
        "examples:spatie-data":   "@php examples/generate.php spatie-data",
        "examples:query-builder": "@php examples/generate.php query-builder",
        "examples:combined":      "@php examples/generate.php combined",
        "examples": [
            "@examples:vanilla",
            "@examples:form-requests",
            "@examples:spatie-data",
            "@examples:query-builder",
            "@examples:combined"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
